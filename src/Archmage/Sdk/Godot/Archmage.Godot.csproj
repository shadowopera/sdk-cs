<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>

    <!-- NuGet Metadata -->
    <PackageId>Shadop.Archmage.Godot</PackageId>
    <Version>0.18.0</Version>
    <Title>Archmage for Godot</Title>
    <Authors>Shadop</Authors>
    <Description>Godot .NET adapters for the Archmage game configuration system: a file system based on FileAccess, a logger that writes to the Godot output, and conversions to Godot types.</Description>
    <PackageProjectUrl>https://archmage.shadop.dev/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/shadowopera/sdk-cs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>archmage;atlas;cfg;config;configuration;excel;table;override;json;godot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build Options -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Archmage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../../unity/dev.shadop.archmage/README.md" Pack="true" PackagePath="\" />
    <None Include="../../../../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
